<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Allows CI or a non-Windows SDK host to resolve WindowsDesktop targeting packs. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PocketLink.App</RootNamespace>
    <AssemblyName>PocketLink.App</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PocketLink.Contracts\PocketLink.Contracts.csproj" />
    <ProjectReference Include="..\PocketLink.Infrastructure\PocketLink.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- H.NotifyIcon.Wpf 用于系统托盘图标（显示/隐藏/退出）。
         SDK/网络受限环境下无法执行 NuGet restore，构建将在此步骤失败，
         详见仓库根 MVP-实现状态.md 的“阻塞”记录。 -->
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.1.3" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.0-rc2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

</Project>
