<Window x:Class="PocketLink.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="PocketLink Monitor"
        Height="640" Width="960"
        MinHeight="480" MinWidth="720">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 连接摘要 -->
        <Border Grid.Row="0" Padding="8" Margin="0,0,0,8" BorderBrush="#DDDDDD" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="型号：" FontWeight="Bold" Margin="0,0,4,0" />
                <TextBlock Text="{Binding Connection.ModelName, TargetNullValue='暂无数据'}" Margin="0,0,16,0" />
                <TextBlock Text="固件：" FontWeight="Bold" Margin="0,0,4,0" />
                <TextBlock Text="{Binding Connection.FirmwareVersion, TargetNullValue='暂无数据'}" Margin="0,0,16,0" />
                <TextBlock Text="网络：" FontWeight="Bold" Margin="0,0,4,0" />
                <TextBlock Text="{Binding Connection.NetworkType}" Margin="0,0,16,0" />
                <TextBlock Text="PPP：" FontWeight="Bold" Margin="0,0,4,0" />
                <TextBlock Text="{Binding Connection.PppStatus, TargetNullValue='暂无数据'}" Margin="0,0,16,0" />
                <TextBlock Text="电池：" FontWeight="Bold" Margin="0,0,4,0" />
                <TextBlock Text="{Binding Connection.BatteryPercent.NormalizedValue, TargetNullValue='—'}" />
                <TextBlock Text="%" Margin="0,0,16,0" />
                <TextBlock Text="{Binding LastError}" Foreground="Red" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <!-- 图表优先：吞吐历史 -->
            <Border Grid.Column="0" Margin="0,0,8,0" BorderBrush="#DDDDDD" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="实时吞吐历史（单位待验证）" FontWeight="Bold" Margin="8" />
                    <lvc:CartesianChart Grid.Row="1" Series="{Binding ThroughputSeries}" Margin="4" />
                </Grid>
            </Border>

            <!-- 信号卡片 -->
            <StackPanel Grid.Column="1">
                <Border Padding="8" Margin="0,0,0,8" BorderBrush="#DDDDDD" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="信号" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding Signal.Rsrp.NormalizedValue, TargetNullValue='无数据/接口不支持'}" FontSize="20" />
                        <TextBlock Text="{Binding Signal.Rsrp.Unit}" Foreground="Gray" />
                        <TextBlock Text="{Binding Signal.RsrpOrigin}" Foreground="Gray" FontSize="11" />
                        <TextBlock Text="已回退至 LTE RSRP" Foreground="Orange" FontSize="11"
                                   Visibility="{Binding Signal.SourceFallback, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
                <Border Padding="8" BorderBrush="#DDDDDD" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="SINR" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding Signal.Sinr.NormalizedValue, TargetNullValue='无数据/接口不支持'}" FontSize="20" />
                        <TextBlock Text="{Binding Signal.Sinr.Unit}" Foreground="Gray" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 底部事件条 -->
        <Border Grid.Row="2" Margin="0,8,0,0" Padding="4" MaxHeight="76" BorderBrush="#DDDDDD" BorderThickness="1">
            <ListBox ItemsSource="{Binding RecentEvents}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding TimestampUtc}" Foreground="Gray" />
                            <Run Text=" · " />
                            <Run Text="{Binding Severity}" />
                            <Run Text=" · " />
                            <Run Text="{Binding Message}" />
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</Window>
