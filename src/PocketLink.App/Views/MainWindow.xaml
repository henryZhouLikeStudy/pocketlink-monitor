<Window x:Class="PocketLink.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="PocketLink 数据监控"
        Height="800" Width="1280"
        MinHeight="600" MinWidth="1024"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: Title and Online Status -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="PocketLink 实时监控"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,16,0" />
                <Border Background="{StaticResource SuccessBrush}"
                        CornerRadius="12"
                        Padding="10,4"
                        VerticalAlignment="Center">
                    <TextBlock Text="在线"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="#0B0E14" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding LastError, TargetNullValue=''}"
                           Foreground="{StaticResource ErrorBrush}"
                           FontSize="13"
                           Margin="0,0,12,0" />
                <TextBlock Text="更新于 "
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding LastUpdatedText}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           FontWeight="Medium"
                           FontFamily="{StaticResource MonoFont}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Device Summary Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="型号"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{Binding ModelText}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="15"
                               FontWeight="Medium"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="固件版本"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{Binding FirmwareText}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="15"
                               FontWeight="Medium"
                               FontFamily="{StaticResource MonoFont}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource StatCard}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="网络类型"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{Binding NetworkTypeText}"
                               Foreground="{StaticResource AccentCyanBrush}"
                               FontSize="15"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="电池电量"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{Binding BatteryText}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="15"
                               FontWeight="Medium"
                               FontFamily="{StaticResource MonoFont}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Content: Chart and Stats -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Throughput Chart and Stats -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Chart Area -->
                <Border Grid.Row="0" Style="{StaticResource DataCard}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="实时吞吐量历史"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12" />
                        <Border Grid.Row="1"
                                Background="{StaticResource ChartBackgroundBrush}"
                                CornerRadius="6"
                                Padding="8">
                            <lvc:CartesianChart Series="{Binding ThroughputSeries}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Throughput Statistics -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="当前下行"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="{Binding CurrentDownloadText}"
                                       Foreground="{StaticResource AccentCyanBrush}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       FontFamily="{StaticResource MonoFont}" />
                            <TextBlock Text="{Binding UnitText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="当前上行"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="{Binding CurrentUploadText}"
                                       Foreground="{StaticResource AccentOrangeBrush}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       FontFamily="{StaticResource MonoFont}" />
                            <TextBlock Text="{Binding UnitText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource StatCard}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="峰值下行"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="{Binding PeakDownloadText}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="20"
                                       FontWeight="Medium"
                                       FontFamily="{StaticResource MonoFont}" />
                            <TextBlock Text="{Binding UnitText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="平均下行"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="{Binding AverageDownloadText}"
                                       Foreground="{StaticResource AccentCyanBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       FontFamily="{StaticResource MonoFont}" />
                            <TextBlock Text="{Binding UnitText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       FontWeight="Normal"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Sample Count Badge -->
                <Border Style="{StaticResource StatCard}" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="样本数："
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <TextBlock Text="{Binding SampleCountText}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   FontFamily="{StaticResource MonoFont}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Right: Signal, Network, Device Cards -->
            <StackPanel Grid.Column="1">
                <!-- Signal Card -->
                <Border Style="{StaticResource DataCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="信号强度"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12" />
                        <TextBlock Text="{Binding SignalRsrpText}"
                                   Foreground="{StaticResource AccentCyanBrush}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   FontFamily="{StaticResource MonoFont}"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="{Binding SignalRsrpSourceText}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   Margin="0,0,0,4" />
                    </StackPanel>
                </Border>

                <!-- SINR Card -->
                <Border Style="{StaticResource DataCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="信噪比 (SINR)"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12" />
                        <TextBlock Text="{Binding SignalSinrText}"
                                   Foreground="{StaticResource SuccessBrush}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   FontFamily="{StaticResource MonoFont}"
                                   Margin="0,0,0,4" />
                    </StackPanel>
                </Border>

                <!-- Network Status Card -->
                <Border Style="{StaticResource DataCard}">
                    <StackPanel>
                        <TextBlock Text="网络状态"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="PPP："
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"
                                       Margin="0,0,8,8" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding PppStatusText}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Margin="0,0,0,8" />

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="类型："
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"
                                       Margin="0,0,8,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding NetworkTypeText}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="12"
                                       FontWeight="Medium" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Bottom: Recent Events (Low Priority) -->
        <Border Grid.Row="3"
                Style="{StaticResource DataCard}"
                Margin="0,16,0,0"
                MaxHeight="100">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="最近事件"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12"
                           FontWeight="Medium"
                           Margin="0,0,0,8" />
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding RecentEvents}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                            <Setter Property="Padding" Value="0,2" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="11" FontFamily="{StaticResource MonoFont}">
                                <Run Text="{Binding TimestampUtc, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" />
                                <Run Text=" · " Foreground="{StaticResource TextMutedBrush}" />
                                <Run Text="{Binding Severity, Mode=OneWay}" Foreground="{StaticResource AccentOrangeBrush}" />
                                <Run Text=" · " Foreground="{StaticResource TextMutedBrush}" />
                                <Run Text="{Binding Message, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" />
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>
